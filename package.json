{
  "name": "dsh-vision",
  "version": "0.3.2",
  "type": "module",
  "description": "DSH Computer Use for Windows: see the screen, drive it with real input, and target controls by name through UI Automation (patterns click without moving your mouse). Adds action sequences, window/region capture with coordinate grids, and a Codex-style overlay with Esc abort.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "README_EN.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzy6-a/vision-use.git"
  },
  "homepage": "https://github.com/zzy6-a/vision-use",
  "bugs": {
    "url": "https://github.com/zzy6-a/vision-use/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "computer-use",
    "vision",
    "screenshot",
    "desktop-automation",
    "windows",
    "wsl",
    "ui-automation",
    "uia",
    "accessibility",
    "automation"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pack": "npm pack --silent"
  }
}
